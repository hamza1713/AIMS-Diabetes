# ============================================================
# Environment Configuration — Diabetes Research Assistant
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Application Settings ---
PROJECT_NAME="Diabetes Management & Research Assistant"
API_V1_STR="/api/v1"
DEBUG=True

# --- Database ---
# SQLite for local development (default). For production swap to PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/diabetesdb"
DATABASE_URL="sqlite:///./diabetes_assistant.db"

# --- JWT Authentication ---
# Required when DEBUG=False. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google Gemini API ---
# Required: Get your API key from https://aistudio.google.com/app/apikey
# Used for: Clinical evidence synthesis (single RAG call, replaces CrewAI overhead)
GEMINI_API_KEY="your-gemini-api-key-here"

# --- LLM Provider & Ollama Configuration ---
# Choose "ollama" (for local/cloud open models like gpt-oss:120b-cloud) or "gemini"
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gpt-oss:120b-cloud"
OLLAMA_FALLBACK_TO_GEMINI=True
OLLAMA_SHOW_THINKING=False

# --- ColPali / Byaldi Vector Index ---
# The local PaliGemma 2 model used for zero-OCR PDF visual retrieval.
# Download will happen automatically on first ingest run.
COLPALI_MODEL_NAME="vidore/colpali-v1.2"
INDEX_STORE_PATH="./byaldi_index"

# --- Qdrant (Optional — disabled by default) ---
# Set USE_QDRANT=True to switch from local Byaldi index to hosted Qdrant.
QDRANT_HOST="localhost"
QDRANT_PORT=6333
USE_QDRANT=False

# --- File Storage ---
PAPERS_DIR="../data/papers"
RENDERED_PAGES_DIR="./rendered_pages"
